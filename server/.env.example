DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=invoice_pre_audit
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+08:00
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h

# Tencent Cloud OCR
TENCENTCLOUD_SECRET_ID=replace-with-tencent-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-tencent-secret-key
TENCENTCLOUD_OCR_REGION=ap-guangzhou
TENCENTCLOUD_OCR_ENABLE_PDF=true
TENCENTCLOUD_OCR_ENABLE_MULTIPLE_PAGE=true
TENCENTCLOUD_OCR_ENABLE_OTHER=true
TENCENTCLOUD_OCR_MAX_BASE64_SIZE=10485760
TENCENTCLOUD_OCR_RATE_LIMIT=5
TENCENTCLOUD_OCR_MAX_RETRIES=3
TENCENTCLOUD_OCR_RETRY_BASE_DELAY_MS=500

# Agnes OpenAI-compatible structured extraction
AGNES_API_KEY=replace-with-a-new-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_TIMEOUT_MS=30000
